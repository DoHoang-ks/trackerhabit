# PostgreSQL
DATABASE_URL="postgresql://grit:grit@localhost:5432/grit?schema=public"

# JWT secrets — ĐỔI trong production (dùng chuỗi ngẫu nhiên dài)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Secret cho endpoint cron nội bộ /api/v1/internal/evaluate
INTERNAL_CRON_SECRET="change-me-cron"

# Web Push (VAPID) — sinh: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# PostgreSQL
DATABASE_URL="postgresql://grit:grit@localhost:5432/grit?schema=public"

# JWT secrets — ĐỔI trong production (dùng chuỗi ngẫu nhiên dài)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"

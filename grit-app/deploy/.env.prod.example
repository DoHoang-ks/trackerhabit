# === Sao chép thành deploy/.env và điền giá trị THẬT trước khi up ===

# Domain đã trỏ A record về IP VPS này (Caddy sẽ tự lấy HTTPS)
DOMAIN=grit.your-domain.com

# Postgres
POSTGRES_USER=grit
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=grit
DATABASE_URL=postgresql://grit:CHANGE_ME_strong_db_password@db:5432/grit?schema=public

# JWT — SINH chuỗi ngẫu nhiên mạnh: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_REFRESH_SECRET=CHANGE_ME_another_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Secret cho cron nội bộ: openssl rand -hex 32
INTERNAL_CRON_SECRET=CHANGE_ME_openssl_rand_hex_32

# Rate limit bật mặc định ở production (đặt false để tắt)
RATELIMIT_ENABLED=true

# Web Push (VAPID) — sinh: docker compose run --rm app node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:you@your-domain.com
